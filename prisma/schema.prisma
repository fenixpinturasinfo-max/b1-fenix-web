// Modelo de datos B1 Fenix — Inventario multi-local + POS
// Ver docs/UX-LANDING.md para el contexto de producto.

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─────────────────────────── Usuarios y roles ───────────────────────────

enum Rol {
  ADMINISTRADOR // acceso total, todos los locales, incluye configuración
  GERENTE       // control global de ventas, compras, stock y solicitudes (sin configuración)
  JEFE_LOCAL    // encargado: gestiona inventario, compras y ventas de su local
  VENDEDOR      // POS de su local: ventas, pedidos y arqueo
  BODEGA        // inventario y recepciones de su local
}

/// Qué puede hacer un perfil en una sección del menú.
enum NivelAcceso {
  TOTAL      // consulta y opera
  LECTURA    // consulta, sin modificar
  SIN_ACCESO // la sección no aparece y la ruta se cierra
}

/// Permisos editables desde Configuración › Perfiles.
/// El catálogo de secciones vive en lib/auth/secciones.ts: una sección es una ruta
/// con una pantalla detrás, así que no tiene sentido poder inventarlas en la base.
/// Sin fila para (rol, sección) el nivel es SIN_ACCESO: lo nuevo nace cerrado.
model PermisoPerfil {
  id      String      @id @default(cuid())
  rol     Rol
  seccion String
  nivel   NivelAcceso

  @@unique([rol, seccion])
  @@index([rol])
}

/// Cuánto puede descontar cada perfil sin pedirle autorización a nadie.
///
/// Es el tramo libre del mesón: bajo este techo el cajero cierra la venta solo y el
/// descuento queda registrado a su nombre; pasado el techo aparecen las credenciales del
/// supervisor. Sin fila el tramo es cero, así que un perfil nuevo nace pidiendo permiso.
model TopeDescuento {
  rol Rol @id

  /// Porcentaje del total que el perfil descuenta por su cuenta. 0 = siempre autoriza otro.
  porcentaje Int @default(0)

  /// Techo en pesos, para que un porcentaje chico no se vuelva mucha plata en una venta
  /// grande. 0 = sin techo: manda solo el porcentaje.
  montoMaximo Int @default(0)
}

model Usuario {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  nombre       String
  rol          Rol
  activo       Boolean  @default(true)
  // Local asignado (null solo para ADMINISTRADOR)
  localId      String?
  local        Local?   @relation(fields: [localId], references: [id])
  creadoEn     DateTime @default(now())

  ventas       Venta[]
  movimientos  MovimientoInventario[]
  cajaSesiones CajaSesion[]
  movimientosCaja      MovimientoCaja[]
  solicitudesCreadas   SolicitudReposicion[] @relation("SolicitudesCreadas")
  solicitudesResueltas SolicitudReposicion[] @relation("SolicitudesResueltas")
  ordenesCompraCreadas OrdenCompra[]
  entradasRecibidas    EntradaCompra[]
  facturasCreadas      FacturaCompra[]
  notasCreditoCreadas  NotaCredito[]
  pedidosCreados       PedidoCliente[]
  tomasCreadas         TomaInventario[] @relation("TomasCreadas")
  tomasAplicadas       TomaInventario[] @relation("TomasAplicadas")
  tomasAnuladas        TomaInventario[] @relation("TomasAnuladas")
  lineasContadas       TomaLinea[]      @relation("LineasContadas")
  facturasVentaCreadas FacturaVenta[]   @relation("FacturasVentaCreadas")
  facturasVentaAnuladas FacturaVenta[]  @relation("FacturasVentaAnuladas")
  descuentosVentaAutorizados   Venta[]        @relation("DescuentosVentaAutorizados")
  descuentosFacturaAutorizados FacturaVenta[] @relation("DescuentosFacturaAutorizados")
  solicitudesDescuentoCreadas   SolicitudDescuento[] @relation("SolicitudesDescuentoCreadas")
  solicitudesDescuentoResueltas SolicitudDescuento[] @relation("SolicitudesDescuentoResueltas")
  retirosCreados  RetiroCuenta[] @relation("RetirosCreados")
  retirosAnulados RetiroCuenta[] @relation("RetirosAnulados")

  @@index([localId])
}

// ─────────────────────────── Locales ───────────────────────────

model Local {
  id        String   @id @default(cuid())
  codigo    String   @unique // ej: "SB", "BU"
  nombre    String
  direccion String
  comuna    String
  horario   String?
  activo    Boolean  @default(true)
  // Casa matriz: recibe las solicitudes de reposición de los demás locales
  esMatriz  Boolean  @default(false)
  creadoEn  DateTime @default(now())

  usuarios     Usuario[]
  stocks       StockLocal[]
  ventas       Venta[]
  movimientos  MovimientoInventario[]
  cajaSesiones CajaSesion[]
  solicitudes  SolicitudReposicion[]
  ordenesCompraDestino OrdenCompra[]
  entradasCompra       EntradaCompra[]
  pedidos              PedidoCliente[]
  facturasVenta        FacturaVenta[]
  tomas                TomaInventario[]
  solicitudesDescuento SolicitudDescuento[]
  retirosCuenta        RetiroCuenta[]
  pedidosOnline        PedidoOnline[]
}

// ─────────────────────────── Catálogo ───────────────────────────

model Categoria {
  id        String     @id @default(cuid())
  slug      String     @unique // ej: "pinturas-lacas"
  nombre    String
  productos Producto[]
}

model Producto {
  id             String    @id @default(cuid())
  sku            String    @unique
  codigoBarra    String?   @unique
  slug           String    @unique
  nombre         String
  marca          String
  categoriaId    String
  categoria      Categoria @relation(fields: [categoriaId], references: [id])
  // Lista de precios UNIFICADA: un precio para todos los locales
  precioCosto    Int       @default(0) // CLP, sin decimales
  precioVenta    Int
  precioAnterior Int? // para mostrar ofertas
  imagen         String?
  destacado      Boolean   @default(false)
  activo         Boolean   @default(true)
  creadoEn       DateTime  @default(now())
  actualizadoEn  DateTime  @updatedAt

  stocks       StockLocal[]
  detalleVenta DetalleVenta[]
  movimientos  MovimientoInventario[]
  solicitudes  SolicitudReposicion[]
  ocLineas      OrdenCompraLinea[]
  entradaLineas EntradaCompraLinea[]
  facturaLineas FacturaCompraLinea[]
  ncLineas      NotaCreditoLinea[]
  preciosCompra PrecioCompraProveedor[]
  pedidoLineas  PedidoClienteLinea[]
  facturaVentaLineas FacturaVentaLinea[]
  tomaLineas    TomaLinea[]
  retiroLineas  RetiroCuentaLinea[]
  pedidoOnlineLineas PedidoOnlineLinea[]

  @@index([categoriaId])
  @@index([marca])
}

// ─────────────────────────── Inventario por local ───────────────────────────

model StockLocal {
  id        String  @id @default(cuid())
  productoId String
  producto  Producto @relation(fields: [productoId], references: [id])
  localId   String
  local     Local    @relation(fields: [localId], references: [id])
  cantidad  Int      @default(0)
  stockMin  Int      @default(0) // alerta de reposición
  stockMax  Int?     // tope sugerido de compra
  ubicacion String?  // ej: "Pasillo 2 - Estante B - Nivel 3"
  actualizadoEn DateTime @updatedAt

  @@unique([productoId, localId])
  @@index([localId])
}

enum TipoMovimiento {
  ENTRADA              // compra / recepción
  SALIDA_VENTA         // descuento automático por venta POS
  AJUSTE               // corrección de inventario (+/-)
  MERMA                // pérdida, daño, vencimiento
  TRANSFERENCIA_SALIDA // envío a otro local
  TRANSFERENCIA_ENTRADA // recepción desde otro local
}

model MovimientoInventario {
  id         String         @id @default(cuid())
  tipo       TipoMovimiento
  productoId String
  producto   Producto       @relation(fields: [productoId], references: [id])
  localId    String
  local      Local          @relation(fields: [localId], references: [id])
  // Positivo = entra stock, negativo = sale stock
  cantidad   Int
  usuarioId  String
  usuario    Usuario        @relation(fields: [usuarioId], references: [id])
  // Referencias cruzadas: venta asociada o transferencia hermana
  ventaId    String?
  venta      Venta?         @relation(fields: [ventaId], references: [id])
  // Salida por factura de venta: el equivalente de `ventaId` para el camino sin caja
  facturaVentaId String?
  facturaVenta   FacturaVenta? @relation(fields: [facturaVentaId], references: [id])
  // Salida por retiro a cuenta: el stock sale al retirar, no al cobrar. Va como
  // SALIDA_VENTA porque para el inventario ES una venta; este vínculo la distingue.
  retiroCuentaId String?
  retiroCuenta   RetiroCuenta? @relation(fields: [retiroCuentaId], references: [id])
  // Salida por venta web pagada con Webpay: mismo criterio que el retiro a cuenta.
  pedidoOnlineId String?
  pedidoOnline   PedidoOnline? @relation(fields: [pedidoOnlineId], references: [id])
  transferenciaPar String?  // id del movimiento espejo en el otro local
  // Toma de inventario que lo originó, para poder auditar hacia atrás
  tomaLineaId String?     @unique
  tomaLinea   TomaLinea?  @relation(fields: [tomaLineaId], references: [id])
  nota       String?
  creadoEn   DateTime       @default(now())

  @@index([productoId, localId])
  @@index([localId, creadoEn])
}

// ─────────────────────────── Toma de inventario ───────────────────────────

enum EstadoToma {
  ABIERTA   // en conteo
  CONTADA   // conteo cerrado, esperando revisión
  APLICADA  // los ajustes ya tocaron el stock
  ANULADA
}

/// De dónde salió la línea: el alcance con que se abrió la toma, o alguien que la agregó.
/// Seis faltantes en productos que el alcance no incluía significan algo distinto que
/// seis faltantes en el pasillo que se pidió contar.
enum OrigenLinea {
  ALCANCE
  AGREGADA_MANUAL
  AGREGADA_IMPORT
}

/// Cómo se digitó el conteo. Una cifra que pasó por una planilla fuera del sistema
/// merece otro nivel de confianza que una tecleada frente al producto.
enum OrigenConteo {
  MOVIL
  PLANILLA
}

enum AlcanceToma {
  TOTAL
  CATEGORIA
  UBICACION
  MARCA
  ALTO_VALOR // los de mayor valor en stock: el 20% que concentra el 80%
}

enum MotivoAjuste {
  MERMA
  ROBO
  ERROR_RECEPCION
  ERROR_CONTEO
  VENCIDO
  OTRO
}

/// Conteo físico del stock. A diferencia de un AJUSTE suelto, es un proceso que se abre,
/// se cuenta por partes, se revisa y recién después toca el stock.
model TomaInventario {
  id          String      @id @default(cuid())
  correlativo Int         @unique
  localId     String
  local       Local       @relation(fields: [localId], references: [id])
  estado      EstadoToma  @default(ABIERTA)
  alcance     AlcanceToma
  /// Valor del alcance: id de categoría, texto de ubicación, marca…
  filtro      String?
  /// Sin ver el esperado mientras se cuenta: verlo convierte el conteo en confirmación
  ciego       Boolean     @default(true)
  nota        String?
  creadoPorId String
  creadoPor   Usuario     @relation("TomasCreadas", fields: [creadoPorId], references: [id])
  creadoEn    DateTime    @default(now())
  /// Cuándo se contó de verdad, no cuándo se digitó. De acá sale el `contadoEn` de las
  /// líneas importadas por planilla: si se cuenta el lunes y se importa el miércoles, con
  /// la fecha del upload las ventas del martes aparecerían como faltantes inventados.
  fechaConteo DateTime?
  cerradaEn   DateTime?
  aplicadaPorId String?
  aplicadaPor   Usuario?  @relation("TomasAplicadas", fields: [aplicadaPorId], references: [id])
  aplicadaEn    DateTime?
  /// Anular descarta el conteo sin tocar el stock: queda quién, cuándo y por qué
  anuladaPorId  String?
  anuladaPor    Usuario?  @relation("TomasAnuladas", fields: [anuladaPorId], references: [id])
  anuladaEn     DateTime?
  motivoAnulacion String?

  lineas TomaLinea[]

  @@index([localId, estado])
}

model TomaLinea {
  id         String         @id @default(cuid())
  tomaId     String
  toma       TomaInventario @relation(fields: [tomaId], references: [id], onDelete: Cascade)
  productoId String
  producto   Producto       @relation(fields: [productoId], references: [id])
  /// Congelado al abrir la toma
  esperado   Int
  contado    Int?
  /// Para descontar los movimientos ocurridos después del conteo
  contadoEn  DateTime?
  contadoPorId String?
  contadoPor   Usuario?     @relation("LineasContadas", fields: [contadoPorId], references: [id])
  origen       OrigenLinea  @default(ALCANCE)
  origenConteo OrigenConteo?
  motivo     MotivoAjuste?
  /// Se marca cuando el contador la saltó: vuelve al final de la cola
  saltada    Boolean        @default(false)

  movimiento MovimientoInventario?

  @@unique([tomaId, productoId])
  @@index([tomaId])
}

// ─────────────────────────── Ventas (POS) ───────────────────────────

enum MedioPago {
  EFECTIVO
  DEBITO
  CREDITO
  TRANSFERENCIA
}

enum EstadoVenta {
  COMPLETADA
  ANULADA
}

model Venta {
  id          String      @id @default(cuid())
  // Correlativo por local para el ticket: SB-000123
  correlativo Int
  localId     String
  local       Local       @relation(fields: [localId], references: [id])
  usuarioId   String
  usuario     Usuario     @relation(fields: [usuarioId], references: [id])
  cajaSesionId String?
  cajaSesion  CajaSesion? @relation(fields: [cajaSesionId], references: [id])
  /// Cliente de la ficha de socios, cuando el cajero ingresó su RUT. Null = cliente de
  /// paso. Con ficha, su descuento configurado se aplica solo, sin autorización.
  clienteId   String?
  cliente     SocioNegocio? @relation(fields: [clienteId], references: [id])
  medioPago   MedioPago
  estado      EstadoVenta @default(COMPLETADA)
  subtotal    Int
  descuento   Int         @default(0)
  /// Quién habilitó el descuento. Null cuando no hubo o cuando lo aplicó alguien que ya
  /// tenía el permiso: en ese caso el autorizador es el propio `usuarioId` de la venta.
  descuentoAutorizadoPorId String?
  descuentoAutorizadoPor   Usuario? @relation("DescuentosVentaAutorizados", fields: [descuentoAutorizadoPorId], references: [id])
  descuentoMotivo          String?
  total       Int
  /// Marca comercial de la venta. No afecta subtotal ni total: existe para poder medir
  /// cuántas ventas Premium hace cada vendedor y cada local.
  premium     Boolean     @default(false)
  creadoEn    DateTime    @default(now())

  detalle     DetalleVenta[]
  movimientos MovimientoInventario[]
  /// Retiros a cuenta que esta boleta cobró. Si tiene alguno, la venta NO movió stock:
  /// ya había salido con cada retiro.
  retirosCuenta RetiroCuenta[]

  @@unique([localId, correlativo])
  @@index([localId, creadoEn])
  @@index([localId, premium, creadoEn])
  @@index([cajaSesionId])
  // "Mi turno" filtra por vendedor sobre la tabla que más crece
  @@index([usuarioId, creadoEn])
  // Historial de compras del cliente con ficha
  @@index([clienteId])
}

model DetalleVenta {
  id           String   @id @default(cuid())
  ventaId      String
  venta        Venta    @relation(fields: [ventaId], references: [id], onDelete: Cascade)
  productoId   String
  producto     Producto @relation(fields: [productoId], references: [id])
  cantidad     Int
  // Precio congelado al momento de la venta
  precioUnitario Int
  // Costo congelado al momento de la venta (CPP vigente): permite margen histórico real
  costoUnitario Int    @default(0)
  subtotal     Int

  @@index([ventaId])
}

// ─────────────────────────── Pedidos de clientes ───────────────────────────

enum EstadoPedido {
  PENDIENTE // registrado, por preparar
  PREPARADO // listo para retiro/entrega
  ENTREGADO // retirado por el cliente (el cobro/stock pasa por el POS)
  FACTURADO // se emitió factura de venta: el stock ya salió, no pasa por el POS
  ANULADO
}

model PedidoCliente {
  id          String       @id @default(cuid())
  correlativo Int          @unique // PED-000001
  // Cliente de la ficha de socios (opcional) o cliente de paso
  clienteId   String?
  cliente     SocioNegocio? @relation(fields: [clienteId], references: [id])
  nombreCliente String
  telefono    String?
  // Local de retiro / entrega
  localId     String
  local       Local        @relation(fields: [localId], references: [id])
  estado      EstadoPedido @default(PENDIENTE)
  nota        String?
  total       Int // CLP, precios de venta (IVA incluido)
  creadoPorId String
  creadoPor   Usuario      @relation(fields: [creadoPorId], references: [id])
  creadoEn    DateTime     @default(now())
  entregadoEn DateTime?

  lineas PedidoClienteLinea[]
  factura FacturaVenta?

  @@index([estado, creadoEn])
  @@index([localId])
}

/// Factura de venta.
///
/// A diferencia del pedido —que solo reserva— la factura **es la venta**: descuenta stock
/// y genera los movimientos, igual que una boleta del POS. Es el camino para el cliente
/// empresa que no pasa por caja y paga a plazo.
///
/// El neto se calcula sumando 19% al precio de catálogo, no desglosándolo: acá el precio
/// de lista se toma como valor neto. Por eso el total de una factura creada desde un
/// pedido es 19% mayor que el total del pedido, que sí es IVA incluido.
model FacturaVenta {
  id          String        @id @default(cuid())
  correlativo Int           @unique // interno FV-000001
  /// Folio tributario del facturador electrónico. Vacío hasta que se emite en el SII.
  folioSii    String?
  /// Obligatorio: una factura necesita RUT y razón social, no sirve un cliente de paso
  clienteId   String
  cliente     SocioNegocio  @relation(fields: [clienteId], references: [id])
  /// Vínculo opcional al pedido que la originó, o atado después
  pedidoId    String?       @unique
  pedido      PedidoCliente? @relation(fields: [pedidoId], references: [id])
  localId     String
  local       Local         @relation(fields: [localId], references: [id])
  /// Neto ya rebajado por `descuento`. El IVA se calcula sobre este valor.
  neto        Int
  descuento   Int           @default(0)
  descuentoAutorizadoPorId String?
  descuentoAutorizadoPor   Usuario? @relation("DescuentosFacturaAutorizados", fields: [descuentoAutorizadoPorId], references: [id])
  descuentoMotivo          String?
  iva         Int // 19% del neto
  total       Int
  fechaEmision     DateTime
  condicionPago    String? // CONTADO, 30D, 60D, 90D
  fechaVencimiento DateTime?
  estado      EstadoFactura @default(ABIERTA)
  nota        String?
  creadoPorId String
  creadoPor   Usuario       @relation("FacturasVentaCreadas", fields: [creadoPorId], references: [id])
  creadoEn    DateTime      @default(now())
  pagadaEn    DateTime?
  anuladaPorId String?
  anuladaPor   Usuario?     @relation("FacturasVentaAnuladas", fields: [anuladaPorId], references: [id])
  anuladaEn    DateTime?
  motivoAnulacion String?

  lineas      FacturaVentaLinea[]
  movimientos MovimientoInventario[]
  /// Retiros a cuenta que esta factura cobró. Si tiene alguno, la factura NO movió stock.
  retirosCuenta RetiroCuenta[]

  // Cuentas por cobrar: la vista de vencidas ordena por vencimiento dentro del estado
  @@index([estado, fechaVencimiento])
  @@index([localId, creadoEn])
}

model FacturaVentaLinea {
  id             String       @id @default(cuid())
  facturaId      String
  factura        FacturaVenta @relation(fields: [facturaId], references: [id], onDelete: Cascade)
  productoId     String
  producto       Producto     @relation(fields: [productoId], references: [id])
  cantidad       Int
  /// Neto unitario congelado al emitir
  precioUnitario Int
  subtotal       Int
  /// Costo congelado: el margen histórico no cambia si mañana sube el costo
  costoUnitario  Int

  @@index([facturaId])
}

model PedidoClienteLinea {
  id             String        @id @default(cuid())
  pedidoId       String
  pedido         PedidoCliente @relation(fields: [pedidoId], references: [id], onDelete: Cascade)
  productoId     String
  producto       Producto      @relation(fields: [productoId], references: [id])
  cantidad       Int
  precioUnitario Int // congelado al crear el pedido
  subtotal       Int

  @@index([pedidoId])
}

// ─────────────────────────── Socios de negocios ───────────────────────────

enum TipoSocio {
  CLIENTE
  PROVEEDOR
}

model SocioNegocio {
  id             String    @id @default(cuid())
  tipo           TipoSocio
  // Un mismo RUT puede existir como cliente Y como proveedor (fichas separadas)
  rut            String
  razonSocial    String
  nombreFantasia String?
  giro           String?
  email          String?
  telefono       String?
  direccion      String?
  comuna         String?
  condicionPago  String? // CONTADO, 30D, 60D...
  /// Descuento pactado con el cliente, en % del total (0 = sin descuento). Solo tiene
  /// sentido en fichas CLIENTE. En el POS se aplica solo al ingresar el RUT, y en la
  /// factura al elegir el cliente: quien lo configuró en la ficha ya lo autorizó.
  descuentoPorcentaje Int  @default(0)
  /// Puede llevarse mercadería a cuenta y pagar al consolidar (semana, quincena, mes).
  /// Es crédito informal: alguien tiene que otorgarlo a propósito en la ficha.
  cuentaAbierta  Boolean   @default(false)
  activo         Boolean   @default(true)
  creadoEn       DateTime  @default(now())

  solicitudes   SolicitudReposicion[]
  ordenesCompra OrdenCompra[]
  entradasCompra EntradaCompra[]
  facturasCompra FacturaCompra[]
  preciosCompra  PrecioCompraProveedor[]
  pedidos        PedidoCliente[]
  facturasVenta  FacturaVenta[]
  ventas         Venta[]
  solicitudesDescuento SolicitudDescuento[]
  retirosCuenta  RetiroCuenta[]

  @@unique([rut, tipo])
}

// ─────────────────── Tienda web: pedidos pagados con Webpay ───────────────────

enum EstadoPedidoOnline {
  PENDIENTE_PAGO // creado, esperando que Webpay confirme
  PAGADO         // pago autorizado; el stock ya salió, falta preparar
  DESPACHADO     // entregado al courier o en reparto
  ENTREGADO      // retirado en tienda o recibido por el cliente
  ANULADO        // pago rechazado, abandonado, o no se pudo iniciar
}

enum TipoEntrega {
  RETIRO           // retiro en tienda, gratis
  DESPACHO_ANILLO  // domicilio dentro del anillo: tarifa fija cobrada en Webpay
  DESPACHO_COURIER // fuera del anillo: courier elegido, envío POR PAGAR al recibir
}

/// Pedido del carro público, pagado con Webpay Plus.
///
/// Vive aparte de `Venta` (que exige cajero y caja) y de `PedidoCliente` (que solo
/// reserva): acá el pago llega primero y por internet. **Al confirmar el pago el stock
/// sale de inmediato** del local que entrega, con movimientos SALIDA_VENTA: lo pagado
/// online no puede venderse de nuevo en el mesón. Los montos quedan congelados al
/// iniciar el pago: si el precio cambia mientras el cliente está en Webpay, paga lo
/// que vio.
model PedidoOnline {
  id          String   @id @default(cuid())
  correlativo Int      @unique // WEB-000001
  estado      EstadoPedidoOnline @default(PENDIENTE_PAGO)
  tipoEntrega TipoEntrega

  // Comprador (sin cuenta: la tienda pública no tiene login)
  nombre   String
  email    String
  telefono String

  /// Retiro: dónde retira. Despacho: local que prepara y despacha (casa matriz).
  localId String
  local   Local  @relation(fields: [localId], references: [id])
  direccion String?
  comuna    String?
  /// Courier elegido cuando el envío es por pagar (fuera del anillo).
  courier   String?

  // Montos en CLP, congelados al iniciar el pago
  montoProductos Int
  montoEnvio     Int @default(0)
  total          Int

  // Webpay Plus
  tbkToken        String?  @unique
  tbkAutorizacion String?
  /// Últimos 4 dígitos de la tarjeta, para el comprobante.
  tbkTarjeta      String?
  pagadoEn        DateTime?

  nota         String?
  creadoEn     DateTime  @default(now())
  despachadoEn DateTime?
  entregadoEn  DateTime?

  lineas      PedidoOnlineLinea[]
  movimientos MovimientoInventario[]

  @@index([estado, creadoEn])
  @@index([localId, estado])
}

model PedidoOnlineLinea {
  id         String       @id @default(cuid())
  pedidoId   String
  pedido     PedidoOnline @relation(fields: [pedidoId], references: [id], onDelete: Cascade)
  productoId String
  producto   Producto     @relation(fields: [productoId], references: [id])
  cantidad   Int
  /// Congelado al iniciar el pago: el cliente paga el precio que vio.
  precioUnitario Int
  /// Costo congelado al confirmar, para margen histórico.
  costoUnitario  Int @default(0)
  subtotal       Int

  @@index([pedidoId])
}

// ─────────────────── Cuenta abierta: retiros y cobro consolidado ───────────────────

enum EstadoRetiroCuenta {
  ABIERTO // retirado; el stock ya salió, falta cobrarlo
  COBRADO // consolidado en una boleta o factura
  ANULADO // descartado; el stock volvió con movimientos espejo
}

/// Retiro a cuenta de un cliente especial (estilo SAP B1: la Entrega mueve inventario,
/// la Factura solo cobra).
///
/// El cliente con `cuentaAbierta` se lleva mercadería durante el período; cada retiro
/// **rebaja stock al momento** y congela precio y costo del día. Al cierre (semana,
/// quincena, mes: el período lo decide el negocio, no el sistema) los retiros ABIERTOS
/// se consolidan en una boleta o factura que cobra **sin volver a mover stock**.
///
/// Sin esto el inventario mentiría toda la semana: la pintura está en la obra del
/// cliente pero el sistema la contaría en la estantería.
model RetiroCuenta {
  id          String   @id @default(cuid())
  correlativo Int      @unique // RC-000001
  clienteId   String
  cliente     SocioNegocio @relation(fields: [clienteId], references: [id])
  localId     String
  local       Local    @relation(fields: [localId], references: [id])
  estado      EstadoRetiroCuenta @default(ABIERTO)
  /// Suma de las líneas a precio congelado. En la boleta se lee IVA incluido; en la
  /// factura, como neto (misma convención que el resto del sistema).
  total       Int
  nota        String?
  creadoPorId String
  creadoPor   Usuario  @relation("RetirosCreados", fields: [creadoPorId], references: [id])
  creadoEn    DateTime @default(now())

  // Cobro: exactamente uno de los dos cuando estado = COBRADO
  ventaId        String?
  venta          Venta? @relation(fields: [ventaId], references: [id])
  facturaVentaId String?
  facturaVenta   FacturaVenta? @relation(fields: [facturaVentaId], references: [id])
  cobradoEn      DateTime?

  /// Anular devuelve el stock. Solo sobre retiros ABIERTOS: uno cobrado se corrige
  /// anulando el documento que lo cobró.
  anuladoPorId    String?
  anuladoPor      Usuario? @relation("RetirosAnulados", fields: [anuladoPorId], references: [id])
  anuladoEn       DateTime?
  motivoAnulacion String?

  lineas      RetiroCuentaLinea[]
  movimientos MovimientoInventario[]

  @@index([clienteId, estado])
  @@index([localId, estado])
  @@index([estado, creadoEn])
}

model RetiroCuentaLinea {
  id         String       @id @default(cuid())
  retiroId   String
  retiro     RetiroCuenta @relation(fields: [retiroId], references: [id], onDelete: Cascade)
  productoId String
  producto   Producto     @relation(fields: [productoId], references: [id])
  cantidad   Int
  /// Congelados al retirar: si el precio sube el miércoles, lo del lunes vale lo del lunes
  precioUnitario Int
  costoUnitario  Int
  subtotal       Int

  @@index([retiroId])
}

// ─────────────────── Aprobación de descuentos por correo ───────────────────

enum EstadoSolicitudDescuento {
  PENDIENTE
  APROBADA
  RECHAZADA
}

/// Descuento que superó lo que el cajero puede aplicar solo, esperando el visto bueno de
/// gerencia **a distancia**: se envía un correo con enlaces de un clic a cada persona con
/// el permiso `ventas.descuento`, y el POS consulta el estado hasta que alguien resuelva.
///
/// Convive con la autorización presencial (el supervisor teclea sus credenciales en la
/// caja): son dos caminos hacia el mismo vale firmado. La solicitud expira sola —se mide
/// `expiraEn` al consultar, sin proceso de limpieza— y una vez resuelta queda como
/// registro de quién aprobó qué, aunque la venta después no se concrete.
model SolicitudDescuento {
  id            String   @id @default(cuid())
  estado        EstadoSolicitudDescuento @default(PENDIENTE)
  /// "POS" o "FACTURA": para que el correo diga de dónde viene la venta.
  contexto      String
  localId       String
  local         Local    @relation(fields: [localId], references: [id])
  solicitanteId String
  solicitante   Usuario  @relation("SolicitudesDescuentoCreadas", fields: [solicitanteId], references: [id])
  /// Cliente con ficha, si el cajero ingresó su RUT. Da contexto a quien aprueba.
  clienteId     String?
  cliente       SocioNegocio? @relation(fields: [clienteId], references: [id])
  /// Total (o neto, en facturas) al momento de pedir. Referencial: el vale se emite por
  /// `monto` y la Server Action que cobra recalcula la base real desde la BD.
  base          Int
  /// Descuento pedido, en pesos. Es el monto exacto por el que se firma el vale.
  monto         Int
  motivo        String?
  creadoEn      DateTime @default(now())
  expiraEn      DateTime
  resueltaEn    DateTime?
  resueltaPorId String?
  resueltaPor   Usuario? @relation("SolicitudesDescuentoResueltas", fields: [resueltaPorId], references: [id])

  @@index([solicitanteId, creadoEn])
  @@index([estado, creadoEn])
}

// ─────────────────────────── Solicitudes a casa matriz ───────────────────────────

enum EstadoSolicitud {
  PENDIENTE
  COTIZADA // cotización enviada al proveedor, esperando respuesta
  DESPACHADA // copiada a OC (proveedor) · transferencia ejecutada (matriz)
  RECHAZADA
}

enum DestinoSolicitud {
  MATRIZ
  PROVEEDOR
}

model SolicitudReposicion {
  id         String          @id @default(cuid())
  // Correlativo interno del documento: SOL-000001.
  // Las líneas enviadas en un mismo pedido comparten folio (null en registros antiguos).
  correlativo Int?
  productoId String
  producto   Producto        @relation(fields: [productoId], references: [id])
  // Local que solicita la reposición
  localId    String
  local      Local           @relation(fields: [localId], references: [id])
  cantidad   Int
  // Precio unitario referencial (solo solicitudes de compra a proveedor)
  costoUnitario Int?
  // Fecha requerida de entrega (solo solicitudes de compra a proveedor)
  fechaRequerida DateTime?
  nota       String?
  estado     EstadoSolicitud @default(PENDIENTE)
  destino    DestinoSolicitud @default(MATRIZ)
  proveedorId String?
  proveedor  SocioNegocio?   @relation(fields: [proveedorId], references: [id])
  // Documento destino (estilo SAP B1): OC generada al "copiar a" esta solicitud
  ordenCompraId String?
  ordenCompra   OrdenCompra?  @relation(fields: [ordenCompraId], references: [id])

  solicitanteId String
  solicitante   Usuario  @relation("SolicitudesCreadas", fields: [solicitanteId], references: [id])
  resueltoPorId String?
  resueltoPor   Usuario? @relation("SolicitudesResueltas", fields: [resueltoPorId], references: [id])
  notaResolucion String?
  creadoEn   DateTime  @default(now())
  resueltoEn DateTime?

  @@index([estado, creadoEn])
  @@index([localId])
  @@index([correlativo])
}

// ─────────────────────────── Lista de precios de compra ───────────────────────────

// Último precio de compra por proveedor+producto (estilo SAP B1).
// Se actualiza automáticamente al recepcionar/facturar; también editable a mano.
model PrecioCompraProveedor {
  id          String       @id @default(cuid())
  proveedorId String
  proveedor   SocioNegocio @relation(fields: [proveedorId], references: [id])
  productoId  String
  producto    Producto     @relation(fields: [productoId], references: [id])
  precio      Int // CLP neto
  origen      String? // "EC-000012", "Factura 4581" o "Manual"
  actualizadoEn DateTime   @updatedAt

  @@unique([proveedorId, productoId])
  @@index([productoId])
}

// ─────────────────────────── Compras: OC y Recepción ───────────────────────────

enum EstadoOC {
  BORRADOR
  ENVIADA
  RECIBIDA_PARCIAL
  RECIBIDA
  CERRADA
  ANULADA
}

model OrdenCompra {
  id             String   @id @default(cuid())
  correlativo    Int      @unique
  proveedorId    String
  proveedor      SocioNegocio @relation(fields: [proveedorId], references: [id])
  localDestinoId String
  localDestino   Local    @relation(fields: [localDestinoId], references: [id])
  estado         EstadoOC @default(ENVIADA)
  // Fecha requerida de entrega (la que pide Fenix)
  fechaRequerida DateTime?
  // Fecha de entrega comprometida por el proveedor
  fechaEntrega   DateTime?
  nota           String?
  creadoPorId    String
  creadoPor      Usuario  @relation(fields: [creadoPorId], references: [id])
  creadoEn       DateTime @default(now())

  lineas   OrdenCompraLinea[]
  entradas EntradaCompra[]
  factura  FacturaCompra?
  // Documentos base (estilo SAP B1): solicitudes copiadas a esta OC
  solicitudes SolicitudReposicion[]

  @@index([estado, creadoEn])
}

model OrdenCompraLinea {
  id               String      @id @default(cuid())
  ordenCompraId    String
  ordenCompra      OrdenCompra @relation(fields: [ordenCompraId], references: [id], onDelete: Cascade)
  productoId       String
  producto         Producto    @relation(fields: [productoId], references: [id])
  cantidad         Int
  costoUnitario    Int // CLP neto
  cantidadRecibida Int @default(0)

  @@index([ordenCompraId])
}

model EntradaCompra {
  id            String       @id @default(cuid())
  correlativo   Int          @unique
  ordenCompraId String?
  ordenCompra   OrdenCompra? @relation(fields: [ordenCompraId], references: [id])
  proveedorId   String
  proveedor     SocioNegocio @relation(fields: [proveedorId], references: [id])
  localId       String
  local         Local        @relation(fields: [localId], references: [id])
  numeroGuia    String?
  recibidoPorId String
  recibidoPor   Usuario      @relation(fields: [recibidoPorId], references: [id])
  creadoEn      DateTime     @default(now())

  lineas EntradaCompraLinea[]

  @@index([creadoEn])
}

model EntradaCompraLinea {
  id            String        @id @default(cuid())
  entradaId     String
  entrada       EntradaCompra @relation(fields: [entradaId], references: [id], onDelete: Cascade)
  productoId    String
  producto      Producto      @relation(fields: [productoId], references: [id])
  cantidad      Int
  costoUnitario Int // costo histórico de esta recepción (base del CPP)

  @@index([entradaId])
}

// ─────────────────────────── Compras: Factura y Nota de Crédito ───────────────────────────

enum EstadoFactura {
  ABIERTA
  PAGADA
  ANULADA
}

model FacturaCompra {
  id            String       @id @default(cuid())
  correlativo   Int          @unique // interno FC-000001
  numero        String // folio del proveedor
  ordenCompraId String       @unique // una factura por OC (v1)
  ordenCompra   OrdenCompra  @relation(fields: [ordenCompraId], references: [id])
  proveedorId   String
  proveedor     SocioNegocio @relation(fields: [proveedorId], references: [id])
  // true = camino 2: esta factura recepcionó la mercadería pendiente (subió stock + CPP)
  esRecepcionDirecta Boolean @default(false)
  neto          Int
  iva           Int // 19%
  total         Int
  fechaEmision  DateTime
  fechaVencimiento DateTime?
  estado        EstadoFactura @default(ABIERTA)
  creadoPorId   String
  creadoPor     Usuario      @relation(fields: [creadoPorId], references: [id])
  creadoEn      DateTime     @default(now())

  lineas       FacturaCompraLinea[]
  notasCredito NotaCredito[]

  @@index([estado, fechaVencimiento])
}

model FacturaCompraLinea {
  id            String        @id @default(cuid())
  facturaId     String
  factura       FacturaCompra @relation(fields: [facturaId], references: [id], onDelete: Cascade)
  productoId    String
  producto      Producto      @relation(fields: [productoId], references: [id])
  cantidad      Int
  costoUnitario Int

  @@index([facturaId])
}

model NotaCredito {
  id          String        @id @default(cuid())
  correlativo Int           @unique // NC-000001
  facturaId   String
  factura     FacturaCompra @relation(fields: [facturaId], references: [id])
  motivo      String
  total       Int // neto + iva de lo devuelto
  creadoPorId String
  creadoPor   Usuario       @relation(fields: [creadoPorId], references: [id])
  creadoEn    DateTime      @default(now())

  lineas NotaCreditoLinea[]
}

model NotaCreditoLinea {
  id            String      @id @default(cuid())
  notaCreditoId String
  notaCredito   NotaCredito @relation(fields: [notaCreditoId], references: [id], onDelete: Cascade)
  productoId    String
  producto      Producto    @relation(fields: [productoId], references: [id])
  cantidad      Int
  costoUnitario Int

  @@index([notaCreditoId])
}

// ─────────────────────────── Correos de boletas ───────────────────────────

model EmailBoleta {
  id        String   @id @default(cuid())
  ventaId   String
  email     String
  enviadoEn DateTime @default(now())

  @@index([enviadoEn])
}

// ─────────────────────────── Caja y arqueo ───────────────────────────

enum EstadoCaja {
  ABIERTA
  CERRADA
}

/// Movimiento de efectivo dentro del turno, fuera de las ventas.
/// Sin esto el arqueo marca descuadres enormes cada vez que alguien saca plata
/// de la caja para pagar un flete o hace una sangría de seguridad.
enum TipoMovCaja {
  SANGRIA // retiro de efectivo a la bóveda o al banco
  INGRESO // aporte de efectivo a la caja
  GASTO   // pago menor hecho con dinero de la caja
}

model MovimientoCaja {
  id           String      @id @default(cuid())
  cajaSesionId String
  cajaSesion   CajaSesion  @relation(fields: [cajaSesionId], references: [id], onDelete: Cascade)
  tipo         TipoMovCaja
  /// Siempre positivo: el signo lo define el tipo
  monto        Int
  motivo       String
  usuarioId    String
  usuario      Usuario     @relation(fields: [usuarioId], references: [id])
  creadoEn     DateTime    @default(now())

  @@index([cajaSesionId])
}

model CajaSesion {
  id            String     @id @default(cuid())
  localId       String
  local         Local      @relation(fields: [localId], references: [id])
  usuarioId     String
  usuario       Usuario    @relation(fields: [usuarioId], references: [id])
  estado        EstadoCaja @default(ABIERTA)
  // Arqueo
  montoApertura Int        // efectivo inicial en caja
  montoCierre   Int?       // efectivo contado al cierre
  montoEsperado Int?       // apertura + ventas efectivo + ingresos − sangrías − gastos
  diferencia    Int?       // cierre - esperado (descuadre)
  notaCierre    String?
  abiertaEn     DateTime   @default(now())
  cerradaEn     DateTime?

  ventas      Venta[]
  movimientos MovimientoCaja[]

  @@index([localId, estado])
  @@index([localId, abiertaEn])
  @@index([usuarioId, estado])
  // El reporte consolidado de gerencia filtra solo por fecha
  @@index([abiertaEn])
}
